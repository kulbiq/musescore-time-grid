{
    "uri": "musescore://extensions/time_grid",
    "type": "composite",
    "title": "Time Grid",
    "description": "Puts the notes on an even time grid and lines up a waveform or spectrogram picture with them.",
    "version": "1.0.0",
    "actions": [
        {
            "code": "dialog",
            "type": "form",
            "title": "Time Grid",
            "modal": false,
            "path": "Main.qml"
        },
        {
            "code": "selftest",
            "type": "macros",
            "title": "Time Grid self-test",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "selftest"
        },
        {
            "code": "verify",
            "type": "macros",
            "title": "Time Grid self-test (reload)",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "verify"
        },
        {
            "code": "all",
            "type": "macros",
            "title": "Time Grid (whole score, headless)",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "all"
        },
        {
            "code": "keepall",
            "type": "macros",
            "title": "Time Grid self-test (keep bars)",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "keepAll"
        },
        {
            "code": "edges",
            "type": "macros",
            "title": "Time Grid self-test (signatures and repeats)",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "edges"
        },
        {
            "code": "figure",
            "type": "macros",
            "title": "Time Grid help figure (headless)",
            "show_on_appmenu": false,
            "path": "core.js",
            "func": "figure"
        }
    ]
}
